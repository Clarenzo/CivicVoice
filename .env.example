# ===========================================
# CivicVoice Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============ APP ==============
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ============ DATABASE ==========
POSTGRES_USER=civicvoice
POSTGRES_PASSWORD=civicvoice123
POSTGRES_DB=civicvoice
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============ REDIS =============
REDIS_HOST=localhost
REDIS_PORT=6379

# ============ JWT ===============
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ============ PGADMIN ==========
PGADMIN_EMAIL=admin@civicvoice.local
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# ============ EMAIL (for notifications) ==========
# Using Ethereal for development - https://ethereal.email/
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@civicvoice.local

# ============ FILE STORAGE ======
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB in bytes
MAX_FILES_PER_COMPLAINT=5

# ============ SWAHILI TRANSLATION ==========
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,sw